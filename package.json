{
  "name": "velox",
  "version": "0.9.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "handling": "node --import tsx tools/scripts/handling-metrics.ts",
    "test:browser": "node tools/scripts/qa-ui.mjs --full && node tools/scripts/qa-hud.mjs && node tools/scripts/qa-network.mjs && node tools/scripts/qa-final.mjs && node tools/scripts/qa-quality.mjs && node tools/scripts/qa-cars.mjs && node tools/scripts/qa-environments.mjs",
    "format": "prettier --write src tests tools/scripts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "lil-gui": "^0.21.0",
    "n8ao": "^2.0.1",
    "peerjs": "^1.5.5",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
